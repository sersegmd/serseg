{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SERSEG: Run Current File",
      "type": "process",
      "command": "serseg",
      "args": [
        "run",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}