{
  "name": "SERSEG",
  "scopeName": "source.serseg",
  "patterns": [
    { "name": "comment.line.number-sign.serseg", "match": "#.*$" },
    { "name": "string.quoted.double.serseg", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.serseg", "match": "\\\\[nrt\\\\\"]" }] },
    { "name": "keyword.control.serseg", "match": "\\b(?:when|otherwise|repeat|from|to|while|each|in|break|continue|give|use)\\b" },
    { "name": "storage.type.serseg", "match": "\\b(?:let|var|mut|const|task)\\b" },
    { "name": "support.type.serseg", "match": "\\b(?:int|float|bool|text|int_array|float_array|bool_array|text_array)\\b" },
    { "name": "support.function.builtin.serseg", "match": "\\b(?:show|assert|push|input|len|str|to_int|to_float|is_int|is_float|utf8_len|utf8_slice|trim|slice|contains|starts_with|ends_with)\\b" },
    { "name": "constant.language.boolean.serseg", "match": "\\b(?:true|false)\\b" },
    { "name": "constant.numeric.serseg", "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
    { "name": "keyword.operator.serseg", "match": "(?:->|==|!=|<=|>=|&&|\\|\\||<<|>>|[+*/%<>=!&|^~:-])" }
  ]
}
